FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props AcmeCommerce.slnx ./
COPY src/ ./src/
RUN dotnet restore AcmeCommerce.slnx
RUN dotnet publish src/AcmeCommerce.Mcp -c Release --no-restore -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out ./
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "AcmeCommerce.Mcp.dll"]
