# Copy to /opt/acmecommerce/runtime.env on the VM, then chmod 600.
# Paste the direct (non-pooler) URL from Neon. Keep the quotes for Compose.
NEON_DATABASE_URL='postgresql://neondb_owner:replaceMe@ep-example.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
JWT_ISSUER=acmecommerce-production
JWT_AUDIENCE=acmecommerce-mcp
JWT_SIGNING_KEY_BASE64=replaceWithBase64OfAtLeast32RandomBytes
PUBLIC_HOST=replace-with-your-name.duckdns.org
